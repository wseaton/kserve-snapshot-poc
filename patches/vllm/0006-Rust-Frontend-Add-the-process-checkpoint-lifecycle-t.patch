From 6c9431395f3b8dc4e5d053c4ef7503f566199a7c Mon Sep 17 00:00:00 2001
From: Will Eaton <weaton@redhat.com>
Date: Tue, 24 Nov 2026 16:35:57 -0500
Subject: [PATCH 6/7] [Rust Frontend] Add the process checkpoint lifecycle to
 gRPC Control

The checkpoint lifecycle is reachable only over HTTP, on the inference
port. An orchestrator that drives vLLM through the gRPC control port
has no way to prepare a process for a checkpoint or bring it back.

Add CheckpointPrepare, CheckpointRestore and GetCheckpointState to the
Control service, served by the same checkpoint module as the
/checkpoint routes: preparing and restoring are idempotent, and a call
the engines cannot honor fails with FAILED_PRECONDITION and says why.
Like those routes, they need sleep mode. An unspecified drain mode
means wait, the routes' default.

New methods on the Control server trait break Rust implementers; they
land in the unreleased vllm-proto 0.7.0.

Assisted-by: Claude
Signed-off-by: Will Eaton <weaton@redhat.com>
---
 rust/proto/control.proto            |  40 ++++
 rust/src/server/src/grpc/control.rs |  79 ++++++-
 rust/src/server/src/grpc/tests.rs   | 306 ++++++++++++++++++++++++++++
 3 files changed, 424 insertions(+), 1 deletion(-)

diff --git a/rust/proto/control.proto b/rust/proto/control.proto
index 437ef523bd..926eb4fe0a 100644
--- a/rust/proto/control.proto
+++ b/rust/proto/control.proto
@@ -31,6 +31,20 @@ service Control {
   rpc Sleep (SleepRequest) returns (SleepResponse) {}
   rpc WakeUp (WakeUpRequest) returns (WakeUpResponse) {}
   rpc IsSleeping (IsSleepingRequest) returns (IsSleepingResponse) {}
+
+  // Process checkpoint lifecycle. These return FAILED_PRECONDITION unless the
+  // engines were started with sleep mode.
+  //
+  // Start preparing every engine for a process checkpoint: drain, then
+  // release the KV cache and what a checkpoint must not contain. Returns once
+  // started; poll GetCheckpointState until PREPARED. Repeating is a no-op.
+  // FAILED_PRECONDITION if the engines refuse, are restoring, or have failed.
+  rpc CheckpointPrepare (CheckpointPrepareRequest) returns (CheckpointStateResponse) {}
+  // Bring back what preparing released and serve again, in the restored
+  // process or in place. A restore in progress or done succeeds, so callers
+  // may repeat it. FAILED_PRECONDITION while preparing or after a failure.
+  rpc CheckpointRestore (CheckpointRestoreRequest) returns (CheckpointStateResponse) {}
+  rpc GetCheckpointState (GetCheckpointStateRequest) returns (CheckpointStateResponse) {}
   rpc InitWeightTransferEngine (InitWeightTransferEngineRequest) returns (InitWeightTransferEngineResponse) {}
   rpc StartWeightUpdate (StartWeightUpdateRequest) returns (StartWeightUpdateResponse) {}
   rpc StartDraftWeightUpdate (StartDraftWeightUpdateRequest) returns (StartDraftWeightUpdateResponse) {}
@@ -157,6 +171,32 @@ message WakeUpResponse {}
 message IsSleepingRequest {}
 message IsSleepingResponse { bool sleeping = 1; }
 
+enum CheckpointState {
+  CHECKPOINT_STATE_UNSPECIFIED = 0;
+  // Serving requests.
+  CHECKPOINT_STATE_RUNNING = 1;
+  // Draining, then releasing what a checkpoint must not contain.
+  CHECKPOINT_STATE_PREPARING = 2;
+  // Safe to capture.
+  CHECKPOINT_STATE_PREPARED = 3;
+  // Bringing back what preparing released.
+  CHECKPOINT_STATE_RESTORING = 4;
+  // Preparing or restoring failed.
+  CHECKPOINT_STATE_FAILED = 5;
+}
+
+message CheckpointPrepareRequest {
+  // How to drain in-flight requests; PAUSE_MODE_UNSPECIFIED means PAUSE_MODE_WAIT.
+  PauseMode mode = 1;
+}
+message CheckpointRestoreRequest {}
+message GetCheckpointStateRequest {}
+message CheckpointStateResponse {
+  CheckpointState state = 1;
+  // Why the lifecycle failed; set only with CHECKPOINT_STATE_FAILED.
+  optional string error = 2;
+}
+
 // The payloads are backend-specific JSON objects. Tensor data remains on the
 // configured NCCL, IPC, or sparse-NCCL transport rather than crossing gRPC.
 message InitWeightTransferEngineRequest { bytes init_info_json = 1; }
