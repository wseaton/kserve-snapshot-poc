 def test_checkpoint_prepare_fails_on_drain_barrier_error(deferred: bool):
     """A failing barrier at the end of the drain leaves the engine FAILED and
diff --git a/vllm/distributed/kv_transfer/kv_connector/v1/base.py b/vllm/distributed/kv_transfer/kv_connector/v1/base.py
index 89fd727307..981caf8508 100644
--- a/vllm/distributed/kv_transfer/kv_connector/v1/base.py
+++ b/vllm/distributed/kv_transfer/kv_connector/v1/base.py
@@ -218,6 +218,11 @@ class KVConnectorBase_V1(ABC):
         """Whether the connector can follow the KV cache remap of sleep mode."""
         return True
 
+    @classmethod
+    def supports_checkpoint(cls, vllm_config: "VllmConfig") -> bool:
+        """Whether a process checkpoint of the engine can be restored."""
+        return False
+
     def __init__(
         self,
         vllm_config: "VllmConfig",
@@ -242,6 +247,15 @@ class KVConnectorBase_V1(ABC):
     def role(self) -> KVConnectorRole:
         return self._role
 
+    def checkpoint_prepare(self) -> None:
+        """Release transports and peer state before a process checkpoint. The
+        KV cache is already released."""
+        return
+
+    def checkpoint_restore(self) -> None:
+        """Bring back what `checkpoint_prepare` released."""
+        return
+
     # ==============================
     # Worker-side methods
     # ==============================
diff --git a/vllm/distributed/kv_transfer/kv_connector/v1/multi_connector.py b/vllm/distributed/kv_transfer/kv_connector/v1/multi_connector.py
index 94a25d3717..cfbb524992 100644
--- a/vllm/distributed/kv_transfer/kv_connector/v1/multi_connector.py
+++ b/vllm/distributed/kv_transfer/kv_connector/v1/multi_connector.py
@@ -249,6 +249,13 @@ class MultiConnector(KVConnectorBase_V1, SupportsHMA):
             for c in children
         )
 
+    @classmethod
+    def supports_checkpoint(cls, vllm_config: "VllmConfig") -> bool:
+        children = cls._get_connector_classes_and_configs(vllm_config)
+        return bool(children) and all(
+            child.supports_checkpoint(config) for child, config in children
+        )
+
     @classmethod
     def _get_connector_classes_and_configs(
         cls, vllm_config: "VllmConfig"
@@ -287,6 +294,14 @@ class MultiConnector(KVConnectorBase_V1, SupportsHMA):
         for c in self._connectors:
             c.restore_kv_caches()
 
+    def checkpoint_prepare(self) -> None:
+        for c in self._connectors:
+            c.checkpoint_prepare()
+
+    def checkpoint_restore(self) -> None:
+        for c in self._connectors:
+            c.checkpoint_restore()
+
     def bind_kv_cache_manager(self, kv_cache_manager: "KVCacheManager") -> None:
         for connector in self._connectors:
             connector.bind_kv_cache_manager(kv_cache_manager)
diff --git a/vllm/v1/engine/core.py b/vllm/v1/engine/core.py
index c93ecfc027..a4d7d2aad3 100644
--- a/vllm/v1/engine/core.py
+++ b/vllm/v1/engine/core.py
@@ -1005,6 +1005,9 @@ class EngineCore:
                 self.release_kv_cache_memory()
                 if self.vllm_config.model_config.checkpoint_release_weights:
                     self.model_executor.discard(("weights",))
+                # The scheduler-side connector stops first and restarts last.
+                if (kv_connector := self.scheduler.get_kv_connector()) is not None:
+                    kv_connector.checkpoint_prepare()
                 self.collective_rpc("checkpoint_prepare")
                 self.collective_rpc("synchronize_device")
                 self._checkpoint_state = CheckpointState.PREPARED
@@ -2444,6 +2447,14 @@ class EngineCoreProc(EngineCore):
             return "Preparing for a checkpoint requires --enable-sleep-mode"
         if self.model_executor.is_sleeping:
             return "Preparing for a checkpoint requires an awake engine"
+        kv_connector = self.scheduler.get_kv_connector()
+        if kv_connector is not None and not kv_connector.supports_checkpoint(
+            self.vllm_config
+        ):
+            return (
+                f"{type(kv_connector).__name__} does not support process "
+                "checkpoints with this configuration"
+            )
         self._checkpoint_state = CheckpointState.PREPARING
         try:
             self.pause_generation(mode=mode, clear_cache=False)
@@ -2469,6 +2480,8 @@ class EngineCoreProc(EngineCore):
             if self.vllm_config.model_config.checkpoint_release_weights:
                 self.wake_up(["weights"])
                 self.collective_rpc("reload_weights")
+            if (kv_connector := self.scheduler.get_kv_connector()) is not None:
+                kv_connector.checkpoint_restore()
             self.wake_up(["kv_cache"])
         except Exception as e:
             self._fail_checkpoint(e)
