From 04a5e638efacd4c7099f8c9b388b8a6c0d4dbfd6 Mon Sep 17 00:00:00 2001
From: Will Eaton <weaton@redhat.com>
Date: Thu, 5 Nov 2026 12:23:51 -0500
Subject: [PATCH] [Distributed] Suspend NCCL communicators in
 checkpoint_prepare

/checkpoint/prepare left the NCCL communicator mapped, so with
NCCL_CUMEM_ENABLE=1 each TP worker kept its peers' cuMem buffers imported
when the process was checkpointed. On driver 580 cuda-checkpoint then
refuses to restore the workers (CUDA_ERROR_NOT_SUPPORTED), and an external
checkpointer has to track and re-import that memory itself, for example
with NVIDIA's cuInterpose.

checkpoint_prepare now calls ncclCommSuspend after releasing the FlashInfer
workspaces, and checkpoint_restore calls ncclCommResume first. At TP=2 on
H200 with custom all-reduce disabled, no CUDA memory is shared between the
workers after prepare, and a lock/checkpoint/restore/unlock cycle through
the CUDA driver API restores a server that returns the same greedy
completion as before.

Custom all-reduce IPC buffers are still mapped after prepare; checkpointing
with it enabled still needs --disable-custom-all-reduce.
---
 .../device_communicators/cuda_communicator.py          | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/vllm/distributed/device_communicators/cuda_communicator.py b/vllm/distributed/device_communicators/cuda_communicator.py
index 56c9e33ee4..4593629a2f 100644
--- a/vllm/distributed/device_communicators/cuda_communicator.py
+++ b/vllm/distributed/device_communicators/cuda_communicator.py
@@ -888,17 +888,23 @@ class CudaCommunicator(DeviceCommunicatorBase):
         checkpoint_restore_fi_ar_workspaces(self.cpu_group, skip_unsupported=True)
 
     def checkpoint_prepare(self) -> None:
-        # Only FlashInfer all-reduce and FlashInfer all2all are supported for now.
+        # Only FlashInfer all-reduce, FlashInfer all2all and NCCL are supported
+        # for now.
         from .flashinfer_all_reduce import checkpoint_prepare_fi_ar_workspaces
 
         checkpoint_prepare_fi_ar_workspaces(self.cpu_group)
         if self.all2all_manager is not None:
             self.all2all_manager.checkpoint_prepare()
+        if self.pynccl_comm is not None:
+            self.pynccl_comm.suspend()
 
     def checkpoint_restore(self) -> None:
-        # Only FlashInfer all-reduce and FlashInfer all2all are supported for now.
+        # Only FlashInfer all-reduce, FlashInfer all2all and NCCL are supported
+        # for now.
         from .flashinfer_all_reduce import checkpoint_restore_fi_ar_workspaces
 
+        if self.pynccl_comm is not None:
+            self.pynccl_comm.resume()
         checkpoint_restore_fi_ar_workspaces(self.cpu_group)
         if self.all2all_manager is not None:
             self.all2all_manager.checkpoint_restore()
