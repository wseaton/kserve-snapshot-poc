+        # for now.
         from .flashinfer_all_reduce import checkpoint_restore_fi_ar_workspaces
 
+        if self.pynccl_comm is not None:
+            self.pynccl_comm.checkpoint_recreate()
         checkpoint_restore_fi_ar_workspaces(self.cpu_group)
         if self.all2all_manager is not None:
             self.all2all_manager.checkpoint_restore()
diff --git a/vllm/distributed/device_communicators/pynccl.py b/vllm/distributed/device_communicators/pynccl.py
index 8981594aff..15cc696ab7 100644
--- a/vllm/distributed/device_communicators/pynccl.py
+++ b/vllm/distributed/device_communicators/pynccl.py
@@ -140,14 +140,19 @@ class PyNcclCommunicator:
         self.available = True
         self.disabled = False
         self._suspended = False
+        self._released = False
 
         self.nccl_version = self.nccl.ncclGetRawVersion()
         if self.rank == 0:
-            # get the unique id from NCCL
-            self.unique_id = self.nccl.ncclGetUniqueId()
             logger.info_once("vLLM is using nccl==%s", self.nccl.ncclGetVersion())
+        self._share_unique_id(group)
+        self._init_comm(device)
+
+    def _share_unique_id(self, group: ProcessGroup | StatelessProcessGroup) -> None:
+        """Get a new unique id on rank 0 and broadcast it over `group`."""
+        if self.rank == 0:
+            self.unique_id = self.nccl.ncclGetUniqueId()
         else:
-            # construct an empty unique id
             self.unique_id = ncclUniqueId()
 
         if not isinstance(group, StatelessProcessGroup):
@@ -160,7 +165,6 @@ class PyNcclCommunicator:
                 self.unique_id.internal[i] = byte
         else:
             self.unique_id = group.broadcast_obj(self.unique_id, src=0)
-        self._init_comm(device)
 
     def _init_comm(self, device: int | str | torch.device) -> None:
         """Create the communicator on `device` from the already-resolved
@@ -640,6 +644,27 @@ class PyNcclCommunicator:
     def deregister_comm_window(self, window):
         return self.nccl.ncclCommWindowDeregister(self.comm, window)
 
+    def checkpoint_release(self) -> None:
+        """Destroy the communicator before a process checkpoint (collective,
+        idempotent). Every CUDA graph that captured an op on it must already
+        be released."""
+        if self.disabled or self._released:
+            return
+        with torch.accelerator.device_index(self.device.index):
+            self.nccl.ncclCommDestroy(self.comm)
+        self._released = True
+
+    def checkpoint_recreate(self) -> None:
+        """Create a new communicator after a process checkpoint (collective,
+        no-op unless released). The process may now run on other GPUs, which
+        invalidates the peer mappings of the old communicator."""
+        if self.disabled or not self._released:
+            return
+        assert self.group is not None
+        self._share_unique_id(self.group)
+        self._init_comm(self.device)
+        self._released = False
+
     def suspend(self):
         """Release comm GPU memory (collective, idempotent); keeps topology."""
         if self.disabled or self._suspended:
diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
index 949dfd79f9..aac0f257a8 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -114,6 +114,7 @@ from vllm.v1.worker.gpu.buffer_utils import set_default_max_concurrency
 from vllm.v1.worker.gpu.cp_utils import prepare_dcp_local_seq_lens
 from vllm.v1.worker.gpu.cudagraph_utils import (
     BatchExecutionDescriptor,
+    CudaGraphManager,
     ModelCudaGraphManager,
     has_compiled_submodule,
     make_cudagraph_stats,
@@ -1153,6 +1154,20 @@ class GPUModelRunner(LoRAModelRunnerMixin):
             and self.cudagraph_manager.needs_capture()
         )
 
+    def release_cuda_graphs(self) -> None:
+        """Drop every captured CUDA graph so `capture_model` can capture them
+        again, for example after the communicators they replay are replaced."""
+        if self.cudagraph_manager is not None:
+            self.cudagraph_manager.release_graphs()
+        for attr in vars(self.speculator).values() if self.speculator else ():
+            if isinstance(attr, CudaGraphManager):
+                attr.release_graphs()
+        CUDAGraphWrapper.clear_all_graphs()
+        BreakableCUDAGraphWrapper.clear_all_graphs()
+        gc.collect()
+        torch.accelerator.synchronize()
+        torch.accelerator.empty_cache()
+
     @torch.inference_mode()
     def capture_model(self, *, profile_only: bool = False) -> int:
         assert self.cudagraph_manager is not None
