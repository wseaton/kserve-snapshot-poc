 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 import contextlib
 import logging
+import os
 import random
 import time
 import uuid
@@ -643,6 +644,117 @@ def test_transfer(
     worker.shutdown()
 
 
+@pytest.mark.parametrize("device", DEVICES)
+@pytest.mark.parametrize("defer_host_setup", [False, True])
+@torch.inference_mode()
+def test_checkpoint_prepare_frees_region_and_restore_serves_transfers(
+    default_vllm_config, device: str, defer_host_setup: bool
+) -> None:
+    """Preparing stops any background setup, unregisters the region, waits for
+    the other ranks, then frees its pages. Restoring brings back zeroed,
+    registered memory at the same addresses, in the background under
+    async_init, and transfers work again. Repeating either is a no-op."""
+    num_gpu_blocks, num_cpu_chunks, page_size_bytes, num_tensors = 16, 8, 1024, 2
+    kv_caches = CanonicalKVCaches(
+        tensors=[
+            CanonicalKVCacheTensor(
+                tensor=torch.zeros(
+                    (num_gpu_blocks, page_size_bytes), dtype=torch.int8, device=device
+                ),
+                page_size_bytes=page_size_bytes,
+            )
+            for _ in range(num_tensors)
+        ],
+        group_data_refs=[
+            [
+                CanonicalKVCacheRef(tensor_idx=i, page_size_bytes=page_size_bytes)
+                for i in range(num_tensors)
+            ]
+        ],
+    )
+    cpu_page_size = round_up(
+        page_size_bytes * num_tensors, SharedOffloadRegion.BLOCK_SIZE_ALIGNMENT
+    )
+    region = SharedOffloadRegion(
+        engine_id=str(uuid.uuid4()),
+        num_chunks=num_cpu_chunks,
+        rank=0,
+        kv_bytes_per_chunk=cpu_page_size,
+        cpu_page_size=cpu_page_size,
+        populate=not defer_host_setup,
+    )
+    region_fd = region.fd
+    assert region_fd is not None
+    at_barrier: list[tuple[bool, int]] = []
+    worker = CPUOffloadingWorker(
+        kv_caches=kv_caches,
+        blocks_per_chunk=1,
+        num_cpu_chunks=num_cpu_chunks,
+        mmap_region=region,
+        defer_host_setup=defer_host_setup,
+        barrier=lambda: at_barrier.append(
+            (region.is_pinned, os.fstat(region_fd).st_blocks * 512)
+        ),
+    )
+    cpu_tensors = worker._store_handler.cpu_tensors
+
+    def wait_ready() -> None:
+        deadline = time.time() + 30
+        while not worker.is_ready() and time.time() < deadline:
+            time.sleep(0.01)
+        assert worker.is_ready()
+
+    try:
+        worker.start_deferred_setup()
+        wait_ready()
+        was_pinned = region.is_pinned
+        addresses = [t.data_ptr() for t in cpu_tensors]
+        for i in range(num_tensors):
+            cpu_tensors[i].fill_(7)
+        assert os.fstat(region_fd).st_blocks * 512 == region.total_size_bytes
+
+        worker.checkpoint_prepare()
+        worker.checkpoint_prepare()
+        assert at_barrier == [(False, region.total_size_bytes)]
+        assert not region.is_pinned
+        assert not worker.is_ready()
+        assert os.fstat(region_fd).st_blocks == 0
+
+        worker.checkpoint_restore()
+        worker.checkpoint_restore()
+        wait_ready()
+        assert region.is_pinned == was_pinned
+        assert os.fstat(region_fd).st_blocks * 512 == region.total_size_bytes
+        assert [t.data_ptr() for t in cpu_tensors] == addresses
+        assert not any(bool(t.any()) for t in cpu_tensors)
+
+        gpu_blocks, cpu_chunks = [3, 9, 12], [5, 0, 6]
+        for i in range(num_tensors):
+            kv_caches.tensors[i].tensor.random_()
+        gpu_spec = GPULoadStoreSpec(
+            gpu_blocks, group_sizes=(len(gpu_blocks),), block_indices=(0,)
+        )
+        assert worker.submit_store(
+            1,
+            resolve_device_pointers(gpu_spec, kv_caches),
+            CPULoadStoreSpec(cpu_chunks),
+        )
+        finished: list[TransferResult] = []
+        deadline = time.time() + 10
+        while not finished and time.time() < deadline:
+            finished = worker.get_finished()
+            time.sleep(0.01)
+        assert [(r.job_id, r.success) for r in finished] == [(1, True)]
+        for i in range(num_tensors):
+            torch.testing.assert_close(
+                cpu_tensors[i][cpu_chunks],
+                kv_caches.tensors[i].tensor[gpu_blocks].cpu(),
+            )
+    finally:
+        del cpu_tensors
+        worker.shutdown()
+
+
 @pytest.mark.parametrize("gpu_to_cpu", [True, False])
 @pytest.mark.parametrize("num_mappings_per_group", NUM_MAPPINGS_PER_GROUP)
 @pytest.mark.parametrize("gpu_page_size_bytes", GPU_PAGE_SIZES)
diff --git a/tests/v1/kv_offload/cpu/test_shared_offload_region.py b/tests/v1/kv_offload/cpu/test_shared_offload_region.py
index 4442c2e6da..a82fdf6c87 100644
--- a/tests/v1/kv_offload/cpu/test_shared_offload_region.py
+++ b/tests/v1/kv_offload/cpu/test_shared_offload_region.py
@@ -1676,3 +1676,52 @@ def test_barrier_release_failure_keeps_original_error(iid, monkeypatch, failure_
 
     assert barrier.call_count == (2 if failure_phase == "population" else 1)
     assert not os.path.exists(f"/dev/shm/vllm_offload_{iid}.mmap")
+
+
+def _shm_blocks(region: SharedOffloadRegion) -> int:
+    assert region.fd is not None
+    return os.fstat(region.fd).st_blocks
+
+
+def _prefault(region: SharedOffloadRegion) -> None:
+    for offset, length in region.prefault_ranges():
+        region.prefault(offset, length)
+
+
+def test_release_pages_frees_memory_and_prefault_brings_it_back(iid):
+    num_chunks = 8
+    region = _make_region(iid, num_chunks=num_chunks)
+    try:
+        view = region.create_next_worker_view(PAGE_SIZE)
+        view.fill_(7)
+        address = view.data_ptr()
+        assert _shm_blocks(region) * 512 == num_chunks * PAGE_SIZE
+
+        region.release_pages()
+        assert _shm_blocks(region) == 0
+
+        region.release_pages()
+        _prefault(region)
+        assert _shm_blocks(region) * 512 == num_chunks * PAGE_SIZE
+        assert view.data_ptr() == address
+        assert int(view.abs().sum()) == 0
+        view.fill_(3)
+        assert int(view.sum()) == 3 * num_chunks * PAGE_SIZE
+        del view
+    finally:
+        region.cleanup()
+
+
+def test_release_pages_is_shared_between_workers(iid):
+    creator = _make_region(iid, num_workers=2, rank=0)
+    joiner = _make_region(iid, num_workers=2, rank=1)
+    try:
+        assert _shm_blocks(creator) * 512 == creator.total_size_bytes
+        creator.release_pages()
+        assert _shm_blocks(joiner) == 0
+        _prefault(creator)
+        _prefault(joiner)
+        assert _shm_blocks(joiner) * 512 == joiner.total_size_bytes
+    finally:
+        joiner.cleanup()
+        creator.cleanup()
