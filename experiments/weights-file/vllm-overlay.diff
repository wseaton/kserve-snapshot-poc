+WEIGHTS_DIR = os.environ.get("VLLM_CHECKPOINT_WEIGHTS_DIR")
+
+
+def create_file_backup(size_in_bytes: int, name: str) -> torch.Tensor:
+    fd = os.open(os.path.join(WEIGHTS_DIR, name), os.O_CREAT | os.O_RDWR, 0o600)
+    try:
+        os.ftruncate(fd, size_in_bytes)
+        mapping = mmap.mmap(fd, size_in_bytes, flags=mmap.MAP_SHARED)
+    finally:
+        os.close(fd)
+    return torch.frombuffer(mapping, dtype=torch.uint8)
+
+
+def copy_pinned(dst: int, src: int, host: int, size_in_bytes: int) -> None:
+    pinned = libcudart.cudaHostRegister(host, size_in_bytes) == 0
+    if not pinned:
+        libcudart.cudaGetLastError()
+    libcudart.cudaMemcpy(dst, src, size_in_bytes)
+    if pinned and libcudart.cudaHostUnregister(host):
+        libcudart.cudaGetLastError()
+
+
+STAGE_BYTES = 1 << 30
+STAGE_THREADS = 8
+_stage: list = []
+
+
+def stage():
+    if not _stage:
+        mapping = mmap.mmap(-1, STAGE_BYTES, flags=mmap.MAP_PRIVATE)
+        buffer = torch.frombuffer(mapping, dtype=torch.uint8)
+        if libcudart.cudaHostRegister(buffer.data_ptr(), STAGE_BYTES):
+            libcudart.cudaGetLastError()
+        _stage[:] = [buffer, ThreadPoolExecutor(STAGE_THREADS), memoryview(mapping)]
+    return _stage
+
+
+def copy_staged(device_ptr: int, host_ptr: int, size_in_bytes: int) -> None:
+    """Host to device through one pinned buffer, filled by several threads."""
+    buffer, pool, _ = stage()
+    stage_ptr = buffer.data_ptr()
+    done = 0
+    while done < size_in_bytes:
+        chunk = min(STAGE_BYTES, size_in_bytes - done)
+        part = -(-chunk // STAGE_THREADS)
+        list(
+            pool.map(
+                lambda at: ctypes.memmove(
+                    stage_ptr + at, host_ptr + done + at, min(part, chunk - at)
+                ),
+                range(0, chunk, part),
+            )
+        )
+        libcudart.cudaMemcpy(device_ptr + done, stage_ptr, chunk)
+        done += chunk
+
+
+def copy_from_file(device_ptr: int, name: str, size_in_bytes: int) -> None:
+    """File to device through the pinned buffer, read by several threads."""
+    buffer, pool, view = stage()
+    fd = os.open(os.path.join(WEIGHTS_DIR, name), os.O_RDONLY)
+    try:
+        done = 0
+        while done < size_in_bytes:
+            chunk = min(STAGE_BYTES, size_in_bytes - done)
+            part = -(-chunk // STAGE_THREADS)
+            list(
+                pool.map(
+                    lambda at: os.preadv(
+                        fd, [view[at : min(at + part, chunk)]], done + at
+                    ),
+                    range(0, chunk, part),
+                )
+            )
+            libcudart.cudaMemcpy(device_ptr + done, buffer.data_ptr(), chunk)
+            done += chunk
+    finally:
+        os.close(fd)
+
